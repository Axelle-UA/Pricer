@page "/brownian-motion"
@using MudBlazor
@using MudBlazor.Charts
@using Pricer.Numerics

<MudText Typo="Typo.h4" Class="mb-2">Brownian Motion Simulator</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Explore how a scaled random walk converges to Brownian motion as the number of steps increases,
    and how volatility scaling affects the nature of the stochastic process.
</MudText>

<!-- ================= SINGLE BM CHART ================= -->
<MudPaper Class="pa-4 mb-4">
    <MudChart ChartType="ChartType.Timeseries"
              ChartSeries="@_series"
              Width="100%"
              Height="350px"
              ChartOptions="_options" />
</MudPaper>

<MudGrid>

    <!-- Slider 1: Number of Steps -->
    <MudItem xs="12">
        <MudText Typo="Typo.h6">Slider 1: Steps (n) — Scaled Random Walk → Brownian Motion</MudText>
        <MudText Typo="Typo.body2" Class="mb-1">
            As n increases, the time step Δt = 1/n shrinks. With correct diffusive scaling (α = 1),
            the path converges to Brownian motion W(t).
        </MudText>
        <MudSlider T="int"
                   Value="_numSteps"
                   ValueChanged="OnNumStepsChanged"
                   Min="5" Max="500" Step="5"
                   Color="Color.Primary">
            Steps (n = @_numSteps, Δt = @((1.0 / _numSteps).ToString("F4")))
        </MudSlider>
    </MudItem>

    <!-- Slider 2: Exponent α -->
    <MudItem xs="12" Class="mt-4">
        <MudText Typo="Typo.h6">Slider 2: Scaling Exponent (α) — Diffusive Scaling</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Var(ΔX) = σ²(Δt)^α. The exponent α controls whether the process freezes, explodes, or converges to Brownian motion.
        </MudText>
        <MudSlider T="double"
                   Value="_alpha"
                   ValueChanged="OnAlphaChanged"
                   Min="0.0" Max="2.0" Step="0.05"
                   Color="Color.Secondary">
            α = @_alpha.ToString("F2")
        </MudSlider>
    </MudItem>

    <!-- Regime badge -->
    <MudItem xs="12" Class="mt-2">
        <MudAlert Severity="@_alertSeverity" Dense="true">
            <strong>Regime: @_regime</strong> — @_diffusiveDescription
        </MudAlert>
    </MudItem>

    <!-- Formula display -->
    <MudItem xs="12" Class="mt-2">
        <MudPaper Class="pa-3" Elevation="0" Style="background:#f5f5f5">
            <MudText Typo="Typo.body2">
                Each increment std dev: σ · (Δt)^(α/2) = 1 · (@((1.0 / _numSteps).ToString("F4")))^(@(_alpha / 2).ToString("F2"))
                = <strong>@BrownianMotionGenerator.ComputeScale(_numSteps, _sigma, _alpha).ToString("F6")</strong>
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-1">
                Total path std dev after n steps: √n · scale = <strong>@(Math.Sqrt(_numSteps) * BrownianMotionGenerator.ComputeScale(_numSteps, _sigma, _alpha)).ToString("F4")</strong>
                @if (_alpha > 1)
                {
                    <span style="color:#1565C0"> → shrinks as n grows (freezing)</span>
                }
                else if (_alpha < 1)
                {
                    <span style="color:#c62828"> → grows as n grows (explosion)</span>
                }
                else
                {
                    <span style="color:#2e7d32"> → stays O(1) as n grows (Brownian)</span>
                }
            </MudText>
        </MudPaper>
    </MudItem>

</MudGrid>

<!-- ================= CORRELATED BROWNIAN MOTIONS ================= -->
<MudDivider Class="my-6" />

<MudText Typo="Typo.h5" Class="mb-2">Correlated Brownian Motions</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Two Brownian paths W₁ and W₂ with correlation ρ.
    When ρ = 1 they move together; when ρ = −1 they move in opposite directions;
    when ρ = 0 they are independent.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudChart ChartType="ChartType.Timeseries"
              ChartSeries="@_corrSeries"
              Width="100%"
              Height="300px"
              ChartOptions="_corrOptions" />
</MudPaper>

<MudGrid>

    <MudItem xs="12">
        <MudText Typo="Typo.h6">Correlation Coefficient (ρ)</MudText>
        <MudSlider T="double"
                   Value="_rho"
                   ValueChanged="OnRhoChanged"
                   Min="-1.0" Max="1.0" Step="0.05"
                   Color="Color.Tertiary">
            ρ = @_rho.ToString("F2")
        </MudSlider>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-3" Elevation="0" Style="background:#f5f5f5">
            <MudText Typo="Typo.body2">
                Construction: W₂ = ρ·W₁ + √(1−ρ²)·W₁⊥, where W₁⊥ is independent of W₁.
                This ensures Cov(W₁(t), W₂(t)) = ρ·t.
            </MudText>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {

    // ================= Single BM fields =================
    private List<ChartSeries<double>> _series = new();

    private TimeSeriesChartOptions _options = new TimeSeriesChartOptions
    {
        YAxisLines = false,
        XAxisLines = false,
        LineStrokeWidth = 1,
        ShowDataMarkers = false,
        XAxisTitle = "Time",
        YAxisTitle = "Value",
        YAxisRequireZeroPoint = false,
    };

    private int _numSteps = 50;
    private double _alpha = 1.0;
    private double _sigma = 1.0;

    private string _regime = "";
    private string _diffusiveDescription = "";
    private Severity _alertSeverity = Severity.Success;

    // ================= Correlated BM fields =================
    private List<ChartSeries<double>> _corrSeries = new();
    private double _rho = 0.0;
    private int _corrSteps = 200;

    private TimeSeriesChartOptions _corrOptions = new TimeSeriesChartOptions
    {
        YAxisLines = false,
        XAxisLines = false,
        LineStrokeWidth = 1.5,
        ShowDataMarkers = false,
        XAxisTitle = "Time",
        YAxisTitle = "Value",
        YAxisRequireZeroPoint = false,
    };

    protected override void OnInitialized()
    {
        RegenerateChart();
        RegenerateCorrelatedChart();
    }

    // ================= Single BM methods =================
    private void OnNumStepsChanged(int value)
    {
        _numSteps = value;
        RegenerateChart();
    }

    private void OnAlphaChanged(double value)
    {
        _alpha = value;
        RegenerateChart();
    }

    private void RegenerateChart()
    {
        UpdateRegime();

        double dt = 1.0 / _numSteps;
        double scale = BrownianMotionGenerator.ComputeScale(_numSteps, _sigma, _alpha);
        var start = new DateTime(2024, 1, 1, 0, 0, 0);

        _series = new List<ChartSeries<double>>
        {
            MakePath("Path 1", start, dt, scale, seed: 1),
            MakePath("Path 2", start, dt, scale, seed: 2),
            MakePath("Path 3", start, dt, scale, seed: 3),
        };

        StateHasChanged();
    }

    private ChartSeries<double> MakePath(string name, DateTime start,
                                          double dt, double scale, int seed)
    {
        var (times, values) = BrownianMotionGenerator.GeneratePath(
            _numSteps, dt, scale, start, seed);

        var data = new TimeValue<double>[_numSteps + 1];
        for (int i = 0; i <= _numSteps; i++)
            data[i] = new TimeValue<double>(times[i], values[i]);

        return new ChartSeries<double>
        {
            Name = name,
            Data = data,
            Visible = true,
        };
    }

    private void UpdateRegime()
    {
        if (_alpha > 1.05)
        {
            _regime = "Freezing";
            _alertSeverity = Severity.Info;
            _diffusiveDescription =
                $"α = {_alpha:F2} > 1: Var(ΔX) = σ²(Δt)^α shrinks too fast. " +
                "As n → ∞ the path collapses to zero — the process freezes.";
        }
        else if (_alpha < 0.95)
        {
            _regime = "Explosion";
            _alertSeverity = Severity.Error;
            _diffusiveDescription =
                $"α = {_alpha:F2} < 1: Var(ΔX) = σ²(Δt)^α shrinks too slowly. " +
                "As n → ∞ the total variation blows up — the process explodes.";
        }
        else
        {
            _regime = "Brownian Motion";
            _alertSeverity = Severity.Success;
            _diffusiveDescription =
                $"α = {_alpha:F2} ≈ 1: the classical diffusive regime. " +
                "Var(ΔX) = σ²Δt — variance grows linearly with time.";
        }
    }

    // ================= Correlated BM methods =================
    private void OnRhoChanged(double value)
    {
        _rho = value;
        RegenerateCorrelatedChart();
    }

    private void RegenerateCorrelatedChart()
    {
        var start = new DateTime(2024, 1, 1);
        double dt = 1.0 / _corrSteps;

        var (p1, p2) = BrownianMotionGenerator.GenerateCorrelatedPaths(
            _corrSteps, 1.0, _rho);

        var data1 = new TimeValue<double>[_corrSteps + 1];
        var data2 = new TimeValue<double>[_corrSteps + 1];

        for (int i = 0; i <= _corrSteps; i++)
        {
            var t = start.AddSeconds(i * dt * 3600);
            data1[i] = new TimeValue<double>(t, p1[i]);
            data2[i] = new TimeValue<double>(t, p2[i]);
        }

        _corrSeries = new List<ChartSeries<double>>
        {
            new() { Name = "W₁", Data = data1, Visible = true },
            new() { Name = "W₂(ρ)", Data = data2, Visible = true },
        };

        StateHasChanged();
    }
}